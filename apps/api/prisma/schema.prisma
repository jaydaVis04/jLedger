generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  pwHash         String
  createdAt      DateTime      @default(now())
  role           Role          @default(USER)
  ledgers        Ledger[]      @relation("ownership")
  activeLedgerId String?
  activeLedger   Ledger?       @relation("activeSelection", fields: [activeLedgerId], references: [id])
  ledgerEntries  LedgerEntry[] @relation("EntryCreatedBy")

  RefreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Ledger {
  id             String        @id @default(cuid())
  user           User          @relation("ownership", fields: [userId], references: [id], onDelete: Cascade)
  name           String
  userId         String
  createdAt      DateTime      @default(now())
  activeForUsers User[]        @relation("activeSelection")
  ledgerEntries  LedgerEntry[]

  @@unique([userId, name])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  ledgerId        String
  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdByUser   User     @relation("EntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  type            String
  amount          Decimal
  currency        String
  memo            String
}
