generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryLineSide {
  DEBIT
  CREDIT
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  pwHash         String
  createdAt      DateTime      @default(now())
  role           Role          @default(USER)
  ledgers        Ledger[]      @relation("ownership")
  activeLedgerId String?
  activeLedger   Ledger?       @relation("activeSelection", fields: [activeLedgerId], references: [id])
  ledgerEntries  LedgerEntry[] @relation("EntryCreatedBy")

  RefreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model Ledger {
  id             String        @id @default(cuid())
  user           User          @relation("ownership", fields: [userId], references: [id], onDelete: Cascade)
  name           String
  userId         String
  createdAt      DateTime      @default(now())
  activeForUsers User[]        @relation("activeSelection")
  ledgerEntries  LedgerEntry[]
  accounts       Account[]
  entryLines     EntryLine[]

  @@unique([userId, name])
  @@index([userId])
}

model LedgerEntry {
  id              String      @id @default(cuid())
  ledgerId        String
  ledger          Ledger      @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdByUser   User        @relation("EntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  type            String
  amount          Decimal
  currency        String
  memo            String
  lines           EntryLine[]

  @@unique([id, ledgerId])  
}

model Account {
  id        String      @id @default(cuid())
  ledgerId  String
  ledger    Ledger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  createdAt DateTime    @default(now())
  lines     EntryLine[]

  @@unique([ledgerId, name])
  @@unique([id, ledgerId])
  @@index([ledgerId])
}

model EntryLine {
  id            String        @id @default(cuid())

  ledgerId      String
  ledger        Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  ledgerEntryId String
  ledgerEntry   LedgerEntry   @relation(fields: [ledgerEntryId, ledgerId], references: [id, ledgerId], onDelete: Cascade)

  accountId     String
  account       Account       @relation(fields: [accountId, ledgerId], references: [id, ledgerId], onDelete: Cascade)

  side          EntryLineSide
  amount        Decimal
  currency      String

  @@index([ledgerId])
}